generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  role String @default("USER")
  active Boolean @default(true)
  avatar String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile Profile?
  sessions Session[]
  resets PasswordReset[]
  goals Goal[]
  foods Food[]
  recipes Recipe[]
  favorites Favorite[]
  entries DiaryEntry[]
  measurements Measurement[]
  plans MealPlan[]
  aiRequests AiRequest[]
  chats ChatSession[]
  shopping ShoppingItem[]
  notifications Notification[]
  feedback Feedback[]
  audits AuditLog[]
  hydration HydrationLog[]
}
model Profile {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  age Int @default(25)
  sex String @default("unspecified")
  height Float @default(170)
  weight Float @default(65)
  targetWeight Float @default(65)
  activity Float @default(1.375)
  objective String @default("maintain")
  diet String @default("normal")
  allergens Json
  dislikes String @default("")
  budget Float @default(150000)
  cookingMinutes Int @default(45)
  meals Int @default(4)
  aiConsent Boolean @default(false)
  chatConsent Boolean @default(false)
  onboarded Boolean @default(false)
  onboardingStep Int @default(0)
  waterGoalMl Int @default(2000)
  updatedAt DateTime @updatedAt
}
model Session {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  refreshHash String @unique
  csrf String
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
}
model PasswordReset {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  tokenHash String @unique
  expiresAt DateTime
}
model Goal {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  calories Float
  protein Float
  carbs Float
  fat Float
  effectiveDate String
  createdAt DateTime @default(now())
  @@index([userId,effectiveDate])
}
model Category {
  id String @id @default(cuid())
  name String @unique
  foods Food[]
}
model Food {
  id String @id @default(cuid())
  name String
  slug String @unique
  searchName String
  description String @db.Text
  image String
  calories Float
  protein Float
  carbs Float
  fat Float
  fiber Float @default(0)
  servingGrams Float @default(100)
  unit String @default("g")
  allergens Json
  diet String @default("vegan")
  source String @default("Dữ liệu demo ước tính, không dùng làm dữ liệu lâm sàng")
  pricePer100g Float @default(5000)
  archived Boolean @default(false)
  categoryId String
  category Category @relation(fields:[categoryId],references:[id])
  ownerId String?
  owner User? @relation(fields:[ownerId],references:[id])
  ingredients Ingredient[]
  favorites Favorite[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerId,archived])
  @@index([categoryId])
}
model Recipe {
  id String @id @default(cuid())
  slug String @unique
  name String
  searchName String
  description String @db.Text
  image String
  steps Json
  servings Float @default(1)
  minutes Int @default(25)
  mealType String @default("lunch")
  tags Json
  archived Boolean @default(false)
  ownerId String?
  owner User? @relation(fields:[ownerId],references:[id])
  ingredients Ingredient[]
  favorites Favorite[]
  planItems PlanItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerId,archived])
}
model Ingredient {
  id String @id @default(cuid())
  recipeId String
  recipe Recipe @relation(fields:[recipeId],references:[id],onDelete:Cascade)
  foodId String
  food Food @relation(fields:[foodId],references:[id])
  grams Float
  @@unique([recipeId,foodId])
}
model Favorite {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  foodId String?
  food Food? @relation(fields:[foodId],references:[id],onDelete:Cascade)
  recipeId String?
  recipe Recipe? @relation(fields:[recipeId],references:[id],onDelete:Cascade)
  @@unique([userId,foodId])
  @@unique([userId,recipeId])
}
model DiaryEntry {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  date String
  meal String
  name String
  image String
  foodId String?
  recipeId String?
  quantity Float
  unit String
  calories Float
  protein Float
  carbs Float
  fat Float
  fiber Float
  baseSnapshot Json
  planItemId String? @unique
  createdAt DateTime @default(now())
  @@index([userId,date])
}
model Measurement {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  date String
  weight Float
  height Float
  note String @default("")
  @@unique([userId,date])
}
model MealPlan {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  name String
  startDate String
  days Int
  mode String @default("manual")
  explanation String @db.Text
  goalSnapshot Json
  isTemplate Boolean @default(false)
  published Boolean @default(false)
  items PlanItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId,startDate])
}
model PlanItem {
  id String @id @default(cuid())
  planId String
  plan MealPlan @relation(fields:[planId],references:[id],onDelete:Cascade)
  recipeId String
  recipe Recipe @relation(fields:[recipeId],references:[id])
  date String
  meal String
  servings Float
  snapshot Json
  consumed Boolean @default(false)
  @@index([planId,date])
}
model AiRequest {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  type String
  mode String
  status String
  model String?
  algorithm String @default("hybrid-v1")
  durationMs Int
  tokens Int @default(0)
  config Json
  result Json
  errorCode String?
  createdAt DateTime @default(now())
  @@index([userId,createdAt])
}
model ChatSession {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  title String
  messages ChatMessage[]
  createdAt DateTime @default(now())
}
model ChatMessage {
  id String @id @default(cuid())
  sessionId String
  session ChatSession @relation(fields:[sessionId],references:[id],onDelete:Cascade)
  role String
  content String @db.Text
  mode String
  createdAt DateTime @default(now())
}
model ShoppingItem {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  planId String?
  foodId String?
  name String
  category String
  grams Float
  cost Float
  checked Boolean @default(false)
  excluded Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([userId,planId])
}
model Article {
  id String @id @default(cuid())
  slug String @unique
  title String
  category String
  image String
  excerpt String @db.Text
  content String @db.Text
  published Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Notification {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  title String
  body String @db.Text
  read Boolean @default(false)
  createdAt DateTime @default(now())
}
model Feedback {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  subject String
  message String @db.Text
  status String @default("open")
  reply String? @db.Text
  createdAt DateTime @default(now())
}
model AuditLog {
  id String @id @default(cuid())
  actorId String?
  actor User? @relation(fields:[actorId],references:[id],onDelete:SetNull)
  action String
  resource String
  createdAt DateTime @default(now())
  @@index([createdAt])
}
model Setting {
  key String @id
  value Json
  updatedAt DateTime @updatedAt
}
model HydrationLog {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  date String
  amountMl Int
  createdAt DateTime @default(now())
  @@index([userId,date])
}
